{
  "name": "api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "imports": {
    "#/*": "./src/*",
    "#test/*": "./test/*",
    "#scripts/*": "./scripts/*"
  },
  "scripts": {
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/index.js --log-level=warning"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@upstash/qstash": "2.12.1",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.40.0",
    "@vercel/functions": "3.10.4",
    "@vercel/otel": "2.1.3",
    "hono": "4.13.14",
    "jose": "6.2.15",
    "libphonenumber-js": "1.13.15",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "msw": "3.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
