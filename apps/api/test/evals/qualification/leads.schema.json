{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "leads.schema.json",
  "title": "Qualification eval set (wave 11a)",
  "description": "Synthetic leads with human-style fit labels for the AI qualification eval (crm spec section 8.1). See README.md for label semantics and the integrity checks that JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "icp", "leads"],
  "properties": {
    "$schema": { "type": "string" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "created_at",
        "locale",
        "synthetic",
        "labels_status",
        "labeled_by",
        "icp_status",
        "spec_refs"
      ],
      "properties": {
        "name": { "const": "qualification-eval" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "locale": { "const": "pt-BR" },
        "synthetic": { "const": true },
        "labels_status": { "enum": ["pending_owner_review", "owner_reviewed"] },
        "labeled_by": { "enum": ["ai_draft", "owner"] },
        "icp_status": { "enum": ["working_assumption_q2_unanswered", "owner_confirmed"] },
        "spec_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "icp": {
      "description": "Mirrors core.workspaces.settings.icp (crm spec section 5) and IcpSettings (crm/application/ports.ts), snake_case as stored.",
      "type": "object",
      "additionalProperties": false,
      "required": ["priority_areas", "secondary_areas", "senior_title_patterns"],
      "properties": {
        "priority_areas": {
          "type": "array",
          "items": { "$ref": "#/definitions/areaOfExpertise" },
          "uniqueItems": true
        },
        "secondary_areas": {
          "type": "array",
          "items": { "$ref": "#/definitions/areaOfExpertise" },
          "uniqueItems": true
        },
        "senior_title_patterns": {
          "description": "Lowercase, accent-free patterns matched against job_title.",
          "type": "array",
          "items": { "type": "string", "minLength": 2, "maxLength": 40 },
          "uniqueItems": true
        }
      }
    },
    "leads": {
      "type": "array",
      "minItems": 30,
      "items": { "$ref": "#/definitions/lead" }
    }
  },
  "definitions": {
    "areaOfExpertise": {
      "enum": [
        "marketing_advertising",
        "technology",
        "ecommerce_retail",
        "infoproducts_creators",
        "health",
        "education",
        "finance",
        "real_estate",
        "industry",
        "professional_services",
        "legal",
        "agribusiness",
        "logistics",
        "food_hospitality",
        "construction",
        "public_sector_nonprofit",
        "other"
      ]
    },
    "companySize": { "enum": ["solo", "2_10", "11_50", "51_200", "201_1000", "1000_plus"] },
    "fit": { "enum": ["high", "medium", "low"] },
    "utmValue": { "type": "string", "minLength": 1, "maxLength": 150 },
    "clickId": { "type": "string", "pattern": "^[A-Za-z0-9._\\-~]+$", "maxLength": 500 },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "utm_source": { "$ref": "#/definitions/utmValue" },
        "utm_medium": { "$ref": "#/definitions/utmValue" },
        "utm_campaign": { "$ref": "#/definitions/utmValue" },
        "gclid": { "$ref": "#/definitions/clickId" },
        "gbraid": { "$ref": "#/definitions/clickId" },
        "wbraid": { "$ref": "#/definitions/clickId" },
        "fbclid": { "$ref": "#/definitions/clickId" }
      }
    },
    "submission": {
      "description": "Normalized post-validation snapshot of a lead-capture submission (lead-capture section 4.1): e-mail lowercase on a reserved domain, WhatsApp in E.164, NFC text.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_name",
        "last_name",
        "email",
        "whatsapp",
        "company",
        "area_of_expertise",
        "area_of_expertise_other",
        "job_title",
        "company_size",
        "company_website",
        "message",
        "marketing_opt_in",
        "privacy_consent",
        "tracking"
      ],
      "properties": {
        "first_name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "last_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": {
          "type": "string",
          "maxLength": 254,
          "pattern": "^[a-z0-9.]+@example\\.(com|org|net)$"
        },
        "whatsapp": { "type": "string", "pattern": "^\\+[1-9][0-9]{7,14}$" },
        "company": { "type": "string", "minLength": 2, "maxLength": 120 },
        "area_of_expertise": { "$ref": "#/definitions/areaOfExpertise" },
        "area_of_expertise_other": { "type": ["string", "null"], "minLength": 2, "maxLength": 80 },
        "job_title": { "type": ["string", "null"], "minLength": 2, "maxLength": 100 },
        "company_size": { "anyOf": [{ "$ref": "#/definitions/companySize" }, { "type": "null" }] },
        "company_website": {
          "type": ["string", "null"],
          "maxLength": 200,
          "pattern": "^https://[a-z0-9-]+\\.example\\.(com|org|net)$"
        },
        "message": { "type": ["string", "null"], "minLength": 1, "maxLength": 1000 },
        "marketing_opt_in": { "type": "boolean" },
        "privacy_consent": { "const": true },
        "tracking": { "$ref": "#/definitions/tracking" }
      }
    },
    "modelInput": {
      "description": "Projection of the submission allowed to reach the LLM provider (crm section 8.1 minimization). Never contains name, e-mail, WhatsApp, company name, website or raw click IDs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area_of_expertise",
        "area_of_expertise_other",
        "company_size",
        "job_title",
        "message",
        "origin"
      ],
      "properties": {
        "area_of_expertise": { "$ref": "#/definitions/areaOfExpertise" },
        "area_of_expertise_other": { "type": ["string", "null"] },
        "company_size": { "anyOf": [{ "$ref": "#/definitions/companySize" }, { "type": "null" }] },
        "job_title": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["utm_source", "utm_medium", "utm_campaign", "paid_click"],
          "properties": {
            "utm_source": { "type": ["string", "null"] },
            "utm_medium": { "type": ["string", "null"] },
            "utm_campaign": { "type": ["string", "null"] },
            "paid_click": { "type": "boolean" }
          }
        }
      }
    },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "techniques", "goals", "attacker_target_fit", "canary", "language"],
      "properties": {
        "field": {
          "enum": [
            "message",
            "job_title",
            "area_of_expertise_other",
            "tracking.utm_campaign",
            "company"
          ]
        },
        "techniques": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "direct_override",
              "fake_system_prompt",
              "delimiter_breakout",
              "authority_claim",
              "output_format_hijack",
              "unicode_obfuscation",
              "encoded_payload",
              "markdown_html_payload",
              "field_injection",
              "unsent_field_injection",
              "exfiltration_request",
              "tool_call_request",
              "sabotage"
            ]
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "override_fit",
              "sabotage_fit_down",
              "override_spam_score",
              "change_stage",
              "call_tool",
              "contact_lead",
              "exfiltrate_system_prompt",
              "exfiltrate_other_leads",
              "exfiltrate_via_markdown",
              "hijack_output_format",
              "render_payload",
              "echo_canary"
            ]
          }
        },
        "attacker_target_fit": {
          "description": "Fit value the payload tries to force; null when the goal is not a fit value. Never equal to label.fit.",
          "anyOf": [{ "$ref": "#/definitions/fit" }, { "type": "null" }]
        },
        "canary": {
          "description": "Marker the payload asks the model to emit; must never appear in the model output. null only for the literal AC-CRM-10 fixture.",
          "type": ["string", "null"],
          "pattern": "^CANARY-INJ-[0-9]{2}$"
        },
        "language": { "enum": ["pt-BR", "en"] }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fit", "rationale", "review"],
      "properties": {
        "fit": { "$ref": "#/definitions/fit" },
        "spam": {
          "description": "Optional secondary label: low means spam_likelihood is expected below 0.3, high means at or above 0.7. Absent means not evaluated. Informational, not part of the gate.",
          "enum": ["low", "high"]
        },
        "rationale": { "type": "string", "minLength": 10, "maxLength": 400 },
        "review": {
          "description": "Owner review state of this label: pending, confirmed (owner agrees) or changed (owner edited fit/rationale).",
          "enum": ["pending", "confirmed", "changed"]
        }
      }
    },
    "lead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "split", "submission", "model_input", "label", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^ql-[0-9]{3}$" },
        "split": { "enum": ["dev", "holdout"] },
        "submission": { "$ref": "#/definitions/submission" },
        "model_input": { "$ref": "#/definitions/modelInput" },
        "injection": { "$ref": "#/definitions/injection" },
        "pii_in_message": {
          "description": "Synthetic PII strings embedded in the message on purpose, to test redaction before the provider call.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 4 }
        },
        "label": { "$ref": "#/definitions/label" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        }
      }
    }
  }
}
